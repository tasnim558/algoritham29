#include <iostream>
using namespace std;

int main()
{
    int stack[100];
    int n, max;

    cout << "Enter number of elements: ";
    cin >> n;

    if (n <= 0 || n > 100)
    {
        cout << "Invalid number of elements!" << endl;
        return 0;
    }

    cout << "Enter stack elements: ";

    for (int i = 0; i < n; i++)
    {
        cin >> stack[i];
    }

    max = stack[0];

    for (int i = 1; i < n; i++)
    {
        if (stack[i] > max)
        {
            max = stack[i];
        }
    }

    cout << "Maximum element: " << max << endl;

    cout << "Original stack: ";

    for (int i = 0; i < n; i++)
    {
        cout << stack[i] << " ";
    }

    cout << endl;

    return 0;
}
