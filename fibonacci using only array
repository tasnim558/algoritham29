#include <iostream>
using namespace std;
int main()
{
    int n, a[100];
    cout << "Enter the number: ";
    cin >> n;
    a[0] = 0;
    a[1] = 1;
    cout << "Fibonacci series: ";
    cout << a[0] << " " << a[1] << " ";
    for (int i = 2; i < n; i++)
    {
        a[i] = a[i - 1] + a[i - 2];
        cout << a[i] << " ";
    }
    return 0;
}
