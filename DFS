#include <iostream>
using namespace std;

int G[10][10], visited[10], n;

void DFS(int i)
{
    cout << i << " ";
    visited[i] = 1;

    for(int j = 0; j < n; j++)
    {
        if(G[i][j] == 1 && visited[j] == 0)
        {
            DFS(j);
        }
    }
}

int main()
{
    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter adjacency matrix:\n";

    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            cin >> G[i][j];
        }
    }

    cout << "\nDFS Traversal: ";
    DFS(0);

    cout << "\n\nGraph Connections:\n";

    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            if(G[i][j] == 1)
            {
                cout << i << " ---> " << j << endl;
            }
        }
    }

    return 0;
}
