#include <iostream>
using namespace std;

int main()
{
    char str[100];
    char s[100];
    int top = -1;

    cout << "Enter a string: ";
    cin >> str;

    for (int i = 0; str[i] != '\0'; i++)
    {
        top++;
        s[top] = str[i];
    }

    cout << "Reversed string: ";

    while (top != -1)
    {
        cout << s[top];
        top--;
    }

    return 0;
}
