
#include <iostream>
using namespace std;

int main()
{
    int n = 5;
    int magic[5][5] = {0};

    int row = 0;
    int col = (n - 1) / 2;

    for (int num = 1; num <= n * n; num++)
    {
        magic[row][col] = num;

        int newRow = row - 1;
        int newCol = col - 1;

        // Up-left boundary check
        if (newRow < 0)
            newRow = n - 1;

        if (newCol < 0)
            newCol = n - 1;

        // Ghor bhora thakle ek ghor niche
        if (magic[newRow][newCol] != 0)
        {
            row = row + 1;

            if (row >= n)
                row = 0;
        }
        else
        {
            row = newRow;
            col = newCol;
        }
    }

    cout << "Magic Square:\n";

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cout << magic[i][j] << "\t";
        }
        cout << endl;
    }

    return 0;
}

