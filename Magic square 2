
#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "Enter an odd positive integer: ";
    cin >> n;

    if (n <= 0)
    {
        cout << "Error: Positive number required!";
        return 0;
    }

    if (n % 2 == 0)
    {
        cout << "Error: Enter an odd number!";
        return 0;
    }

    if (n >= 100)
    {
        cout << "Error: Maximum size is 99!";
        return 0;
    }

    int magic[100][100] = {0};

    int row = 0;
    int col = (n - 1) / 2;

    for (int num = 1; num <= n * n; num++)
    {
        magic[row][col] = num;

        int newRow = row - 1;
        int newCol = col - 1;

        if (newRow < 0)
            newRow = n - 1;

        if (newCol < 0)
            newCol = n - 1;

        if (magic[newRow][newCol] != 0)
        {
            row++;

            if (row >= n)
                row = 0;
        }
        else
        {
            row = newRow;
            col = newCol;
        }
    }

    cout << "Magic Square:\n";

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cout << magic[i][j] << "\t";
        }
        cout << endl;
    }

    return 0;
}
