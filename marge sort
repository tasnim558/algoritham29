#include <iostream>
using namespace std;

int a[100], temp[100];

void merge(int left, int mid, int right)
{
    int first = left;
    int second = mid + 1;
    int position = left;

    while (first <= mid && second <= right)
    {
        if (a[first] < a[second])
        {
            temp[position] = a[first];
            first++;
        }
        else
        {
            temp[position] = a[second];
            second++;
        }
        position++;
    }

    while (first <= mid)
    {
        temp[position] = a[first];
        first++;
        position++;
    }

    while (second <= right)
    {
        temp[position] = a[second];
        second++;
        position++;
    }

    for (int index = left; index <= right; index++)
    {
        a[index] = temp[index];
    }
}

void mergeSort(int left, int right)
{
    if (left < right)
    {
        int middle = (left + right) / 2;

        mergeSort(left, middle);
        mergeSort(middle + 1, right);

        merge(left, middle, right);
    }
}

int main()
{
    int n;

    cout << "Enter array size: ";
    cin >> n;

    cout << "Enter array elements: ";

    for (int index = 0; index < n; index++)
    {
        cin >> a[index];
    }

    mergeSort(0, n - 1);

    cout << "Sorted array: ";

    for (int index = 0; index < n; index++)
    {
        cout << a[index] << " ";
    }

    return 0;
}
